# Production Environment Configuration
PROJECT_NAME="Global Job Discovery Platform"
SECRET_KEY="generate-a-strong-random-key-in-production-using-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Authoritative PostgreSQL 17
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-strong-db-password"
POSTGRES_DB="job_discovery"

# Storage Settings
MAX_RESUME_SIZE_BYTES=5242880
UPLOAD_DIR="./storage/resumes"

# CORS Configuration (PRD 9.1: explicitly configured origins; comma-separated or JSON array)
# Local development:
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
# Production example:
# BACKEND_CORS_ORIGINS="https://jobs.yourdomain.com,https://app.yourdomain.com"

# Ingestion Settings
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_CONCURRENCY=1

# Background Scheduler Settings (PRD §5.4 & §10.2)
ENABLE_BACKGROUND_SCHEDULER="false"
SCHEDULER_INTERVAL_SECONDS=300

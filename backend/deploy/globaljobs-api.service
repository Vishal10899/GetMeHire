[Unit]
Description=GetMeHire FastAPI Production ASGI Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=getmehire
Group=getmehire
WorkingDirectory=/opt/getmehire/backend
Environment="PATH=/opt/getmehire/backend/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/getmehire/backend/.env
ExecStart=/opt/getmehire/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips *
Restart=always
RestartSec=5
StandardOutput=append:/var/log/getmehire/api.log
StandardError=append:/var/log/getmehire/api_err.log
LimitNOFILE=65535

# Security Sandbox controls
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
